 SG_ FuelCounter : 0|16@1+ (1,0) [0|65535] "counts" DISPLAY

BO_ 1017 DME_Temperatures: 8 DME
 SG_ VacuumDomainPressure : 24|8@1+ (1,0) [0|255] "" DISPLAY
 SG_ CoolantTemp : 32|8@1+ (1,-48) [-48|207] "degC" DISPLAY
 SG_ OilTemp : 40|8@1+ (1,-48) [-48|207] "degC" DISPLAY

BO_ 417 Chassis_VehicleSpeed: 5 Vector__XXX
 SG_ VehicleSpeed : 16|16@1+ (0.015625,0) [0|1023.984375] "km/h" DISPLAY

BO_ 816 KOMBI_FuelOdometer: 8 KOMBI
 SG_ Odometer : 0|24@1+ (1,0) [0|16777215] "km" DISPLAY
 SG_ FuelTotalDamped : 24|8@1+ (1,0) [0|255] "l" DISPLAY
 SG_ FuelLevelLeft : 32|8@1+ (0.5,0) [0|127.5] "l" DISPLAY
 SG_ FuelLevelRight : 40|8@1+ (0.5,0) [0|127.5] "l" DISPLAY
 SG_ Range : 48|16@1+ (0.0625,0) [0|4095.9375] "km" DISPLAY

BO_ 841 JBE_FuelSenders: 5 JBE
 SG_ FuelSenderRaw1 : 0|16@1+ (1,0) [0|65535] "counts" DISPLAY
 SG_ FuelSenderRaw2 : 16|16@1+ (1,0) [0|65535] "counts" DISPLAY

BO_ 760 KOMBI_DateTime: 8 KOMBI
 SG_ Hour : 0|8@1+ (1,0) [0|23] "h" DISPLAY
 SG_ Minute : 8|8@1+ (1,0) [0|59] "min" DISPLAY
 SG_ Second : 16|8@1+ (1,0) [0|59] "s" DISPLAY
 SG_ Day : 24|8@1+ (1,0) [1|31] "d" DISPLAY
 SG_ Month : 36|4@1+ (1,0) [1|12] "mo" DISPLAY
 SG_ Year : 40|16@1+ (1,0) [0|65535] "y" DISPLAY

BO_ 304 Body_TerminalStatus: 8 Vector__XXX
