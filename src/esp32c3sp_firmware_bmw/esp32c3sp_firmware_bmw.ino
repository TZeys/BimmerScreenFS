// ================= vehicle state =================
float rpm = 0, speed = 0, dist = 0, boost = 0;
int coolant = 0, oil = 0;
float tank_total = 0;
float l_per_100km = 0;   // L/100km when moving, L/h at standstill (EXPERIMENTAL, see 0x300)
uint32_t last_t = 0;
uint32_t lastDisplayUpdate = 0, lastIgnitionChange = 0, lastStatusPrint = 0;

int pendingAudioTrack = -1;
uint32_t lastAudioTime = 0;
bool oilWarnTriggered = false, coolantWarnTriggered = false, rpmWarnTriggered = false;
bool systemIsOn = false;

// change detection on DISPLAYED precision, so sub-pixel jitter never redraws
int prev_rpm = -1, prev_speed = -1, prev_coolant = -1, prev_oil = -1;
long prev_dist = -1, prev_boost = -99999, prev_tank = -1, prev_consum = -1;

// ================= fuel level self-calibration =================
// 0x349 carries the two raw tank senders (fine resolution, unknown curve).
// 0x330 B4/B5 carries the cluster's computed left/right level in 0.5L steps.
// Every time a 0.5L step ticks, the smoothed raw value at that moment is a
// calibration anchor: raw <-> (k * 0.5L). Anchors persist in NVS flash and
// let us interpolate the raw senders to ~0.1L between the 0.5L steps.
#define ANCHOR_SLOTS 82   // slot k = k*0.5 litres boundary (0 .. 40.5L)
uint16_t ancL[ANCHOR_SLOTS], ancR[ANCHOR_SLOTS];
float emaA = -1, emaB = -1;   // smoothed 0x349 fields: A = bytes 0-1, B = bytes 2-3
int8_t pairing = 0;           // which raw field is which side: 0 unknown, 1 A=left, 2 A=right
int8_t pairVote = 0;          // learned by watching which field moves when a side ticks
uint8_t halvesL = 0xFF, halvesR = 0xFF;  // last confirmed 0x330 half-litre values
uint8_t pendL = 0xFF, pendR = 0xFF;      // pending transition awaiting confirmation
float tickBaseA = -1, tickBaseB = -1;    // ema snapshot at last confirmed tick

// ================= instantaneous consumption =================
// 0x2C4 (~7 Hz): bytes 0-1 LE = DME fuel integrator. ~278 counts/s at warm
// idle, frozen with engine off (verified across 3 logs incl. shutoff event).
// Quantum ~1 uL/count -> 278 uL/s = 1.0 L/h idle. If the display disagrees
// with the OBC by a constant factor, trim LITRES_PER_COUNT.
const float LITRES_PER_COUNT = 0.000001f;   // validated: display 29.5 vs cluster 28.2 L/100km at WOT
uint16_t consPrev = 0;
bool consHave = false;
uint32_t consAccum = 0, consWindowStart = 0;
float lph = -1;

// ================= boost (0x2F3 B4-B5 LE = manifold pressure sensor) =================
// Real sensor, verified on the N47 diesel: jitters and drifts barometrically when
// the engine is off, +874 mbar at the logged full-load point (matching the ~+0.9
// bar the 59 mg/stroke fueling physically requires), dips to -230 mbar on overrun
// (intake flap), and decays smoothly instead of snapping with the pedal. Scale
// 0.5 mbar/count. Ambient reference captured while the engine isn't running, so
// weather/altitude self-correct every start. The last capture is persisted in NVS
// and loaded at boot: if the engine is already running before the display finishes
// booting, there is no engine-off window this drive, so yesterday's ambient (a few
// mbar off at worst) is used instead of showing 0 all drive.
const float BOOST_BAR_PER_COUNT = 0.0005f;
uint16_t baroRef = 0;
uint16_t baroSaved = 0;              // value currently stored in NVS
unsigned long lastBaroSave = 0;
bool rpmSeen = false;                // an 0xA5 frame has arrived (rpm==0 is trustworthy)

void safePlay(int track) {
  while (DFSerial.available()) DFSerial.read();  // drop stale module responses
  myDFPlayer.play(track);
}

uint16_t getTempColor(int temp) {
  if (temp < 60) return tft.color565(0, 150, 255);
  if (temp < 85) return tft.color565(0, map(temp, 60, 85, 150, 255), map(temp, 60, 85, 255, 0));
  if (temp <= 95) return tft.color565(0, 255, 0);
  if (temp < 110) return tft.color565(map(temp, 95, 110, 0, 255), map(temp, 95, 110, 255, 0), 0);
  return tft.color565(255, 0, 0);
}

uint16_t getRpmColor(float r) {
  if (r >= 5000) return 0xF800;
  if (r >= 4000) return 0xFFE0;
  return 0xFFFF;
}

// ================= animations =================
// All effects are incremental (each frame pushes only new pixels) or work on
// small strips - full-frame redraws are too slow over SPI for smooth motion.
// PROGMEM pixels are ALWAYS staged through RAM first: Adafruit's PROGMEM
// drawRGBBitmap overload falls back to one clipped writePixel per pixel
// (~20x slower than the bulk-SPI RAM path). On ESP32 flash is memory-mapped,
// so memcpy straight out of the bitmap is legal and fast.
static uint16_t animRow[320];
static uint16_t stripBuf[320 * 8];                // 5 KB staging strip
GFXcanvas16 charCanvas(18, 24);                   // one size-3 classic font cell

float easeOutCubic(float p) { float q = 1.0f - p; return 1.0f - q * q * q; }

void blitBmpRows(int y0, int rows) {              // background 1:1 at (0,0), fast path
  while (rows > 0) {
    int n = (rows > 8) ? 8 : rows;
    memcpy(stripBuf, &image_image_mesh_gradient_pixels[y0 * 320], n * 320 * 2);
    gfx->drawRGBBitmap(0, y0, stripBuf, 320, n);
    y0 += n;
    rows -= n;
  }
}

// one background row segment; caller must hold tft.startWrite()
void writeBmpRowSegment(int x0, int x1, int y) {
  if (y < 0 || y > 239) return;
  if (x0 < 0) x0 = 0;
  if (x1 > 319) x1 = 319;
  if (x1 < x0) return;
  int w = x1 - x0 + 1;
  memcpy(animRow, &image_image_mesh_gradient_pixels[y * 320 + x0], w * 2);
  tft.setAddrWindow(x0, y, w, 1);
  tft.writePixels(animRow, w);
}

void irisReveal(uint16_t durMs) {                 // expanding circle reveal of the background
  const int cx = 160, cy = 120;
  const float rMax = 202.0f;                      // reaches the corners
  int prevR = 0;
  uint32_t start = millis();
  for (;;) {
    float p = (millis() - start) / (float)durMs;
    if (p > 1) p = 1;
    int r = (int)(easeOutCubic(p) * rMax);
    if (r > prevR) {
      tft.startWrite();                           // one SPI transaction per frame
      for (int y = cy - r; y <= cy + r; y++) {
        if (y < 0 || y > 239) continue;
        int dy = y - cy;
        int half = (int)sqrtf((float)(r * r - dy * dy));
        if (abs(dy) >= prevR) {
          writeBmpRowSegment(cx - half, cx + half, y);
        } else {                                  // only the newly revealed ring
          int prevHalf = (int)sqrtf((float)(prevR * prevR - dy * dy));
          writeBmpRowSegment(cx - half, cx - prevHalf - 1, y);
          writeBmpRowSegment(cx + prevHalf + 1, cx + half, y);
        }
      }
      tft.endWrite();
      prevR = r;
    }
    if (p >= 1) break;
    delay(3);
  }
  blitBmpRows(0, 240);                            // close rounding gaps
}

void slideTitle() {                               // title eases in from the left on a strip canvas
  GFXcanvas16* strip = new GFXcanvas16(320, 40);
  if (!strip) {                                   // heap fallback: draw statically
    gfx->setFont(&FreeSansBold18pt7b);
    gfx->setTextSize(1);
    gfx->setTextColor(0xFFFF);
    gfx->setCursor(20, 50);
    gfx->print("TZengineering");
    gfx->setFont();
    return;
  }
  uint32_t start = millis();
  for (;;) {
    float p = (millis() - start) / 500.0f;
    if (p > 1) p = 1;
    int tx = -240 + (int)(easeOutCubic(p) * 260); // ends at x=20
    uint16_t* b = strip->getBuffer();
    memcpy(b, &image_image_mesh_gradient_pixels[18 * 320], 320 * 40 * 2);
    strip->setFont(&FreeSansBold18pt7b);
    strip->setTextSize(1);
    strip->setTextWrap(false);
    strip->setTextColor(0xFFFF);
    strip->setCursor(tx, 32);                     // baseline 50 - stripY 18
    strip->print("TZengineering");
    gfx->drawRGBBitmap(0, 18, b, 320, 40);
    if (p >= 1) break;
  }
  delete strip;
}

void typeLine3(int x, int y, const char* s, uint16_t color) {  // typewriter, size-3 font
  // each char is composited on a background patch off-screen and pushed as one
  // block, so it pops instantly instead of raster-scanning in over SPI
  uint16_t* b = charCanvas.getBuffer();
  while (*s) {
    for (int r = 0; r < 24; r++)
      memcpy(&b[r * 18], &image_image_mesh_gradient_pixels[(y + r) * 320 + x], 18 * 2);
    charCanvas.drawChar(0, 0, *s, color, color, 3);   // bg==fg: transparent
    gfx->drawRGBBitmap(x, y, b, 18, 24);
    x += 18;
    s++;
    delay(25);
  }
}

void shutdownAnimation() {                        // CRT power-off: collapse to line, to dot, fade
  const int cy = 120;
  uint32_t start = millis();
  int prevTop = 0;
  for (;;) {                                      // vertical collapse
    float p = (millis() - start) / 450.0f;
    if (p > 1) p = 1;
    int top = cy - ((int)((1.0f - p * p) * 118) + 2);
    if (top > prevTop) {
      gfx->fillRect(0, prevTop, 320, top - prevTop, 0x0000);
      gfx->fillRect(0, 240 - top, 320, top - prevTop, 0x0000);
      gfx->drawFastHLine(0, top, 320, 0xFFFF);
      gfx->drawFastHLine(0, 239 - top, 320, 0xFFFF);
      prevTop = top;
    }
    if (p >= 1) break;
    delay(5);
  }
  gfx->fillRect(0, cy - 2, 320, 4, 0xFFFF);       // solid bright band
  start = millis();
  int prevHw = 160;
  for (;;) {                                      // horizontal collapse
    float p = (millis() - start) / 300.0f;
    if (p > 1) p = 1;
    int hw = (int)((1.0f - p * p) * 156) + 4;
    if (hw < prevHw) {
      gfx->fillRect(160 - prevHw, cy - 2, prevHw - hw, 4, 0x0000);
      gfx->fillRect(160 + hw, cy - 2, prevHw - hw, 4, 0x0000);
      prevHw = hw;
    }
    if (p >= 1) break;
    delay(5);
  }
  for (int g = 240; g >= 0; g -= 40) {            // dot fade-out
    gfx->fillRect(155, cy - 2, 10, 4, tft.color565(g, g, g));
    delay(35);
  }
  gfx->fillScreen(0x0000);
}

void drawScreen_2() {
  gfx->fillScreen(0x0000);
  irisReveal(700);
  slideTitle();
  typeLine3(40, 100, "Booting...", 0xFFFF);
  typeLine3(40, 140, "PT-CANBUS", 0xFFFF);
  delay(250);
  typeLine3(240, 140, "OK", 0x07E0);
  typeLine3(40, 180, "AUDIO", 0xFFFF);
  delay(250);
  typeLine3(180, 180, "OK", 0x07E0);
  delay(400);
}

void drawScreen_1(void) {
  // top-to-bottom sweep with a bright scanline edge; band placement matches
  // the original full blit at (-1,-1) so the value patches still line up:
  // screen (c,d) shows source (c+1,d+1), column 319 stays black
  for (int y = 0; y < 240; y += 8) {
    int d0 = (y == 0) ? 0 : y - 1;
    int n = y + 7 - d0;
    for (int r = 0; r < n; r++) {
      memcpy(&stripBuf[r * 320], &image_image_mesh_gradient_pixels[(d0 + r + 1) * 320 + 1], 319 * 2);
      stripBuf[r * 320 + 319] = 0x0000;
    }
    gfx->drawRGBBitmap(0, d0, stripBuf, 320, n);
    if (y < 232) gfx->drawFastHLine(0, y + 7, 320, 0xFFFF);
    delay(8);
  }
  gfx->drawFastVLine(319, 0, 240, 0x0000);  // edges the blit never covers
  gfx->drawFastHLine(0, 239, 320, 0x0000);
  gfx->setTextColor(0xFFFF);
  gfx->setTextSize(2);
  gfx->setTextWrap(false);
  gfx->setFont();
  gfx->setCursor(155, 94); gfx->println("RPM");
  gfx->setCursor(155, 129); gfx->println("SPEED");
  gfx->setCursor(155, 164); gfx->println("DIST");
  gfx->setCursor(19, 95); gfx->println("OIL");
  gfx->setCursor(17, 130); gfx->println("COOL");
  gfx->setCursor(17, 165); gfx->println("BOOST");
  gfx->setCursor(155, 198); gfx->println("CONSUM.");
  gfx->setTextSize(1);
  gfx->setFont(&FreeMonoBoldOblique9pt7b);
  gfx->setCursor(7, 18); gfx->println("TZengineering");
  gfx->setTextSize(2);
  gfx->setFont();
  gfx->setCursor(88, 96); gfx->println("---");
  gfx->setCursor(88, 130); gfx->println("---");
  gfx->setCursor(88, 164); gfx->println("---");
  gfx->setCursor(253, 93); gfx->println("---");
  gfx->setCursor(253, 129); gfx->println("---");
  gfx->setCursor(253, 163); gfx->println("---");
  gfx->setCursor(253, 197); gfx->println("---");
  gfx->setCursor(17, 198); gfx->println("TANK");
  gfx->setCursor(88, 198); gfx->println("---");
}

// GIF-style staggered reveal: after boot, value slots unlock one after
// another in the preview's order: right column top to bottom, then left
// column top to bottom. Non-blocking: a slot simply isn't drawn until its
// gate opens, so CAN keeps draining meanwhile. After ~1.4s all gates stay open.
unsigned long revealStart = 0;
static inline bool slotOpen(uint8_t i) { return millis() - revealStart >= 200UL + i * 150UL; }

// Composite background patch + text off-screen, push in one SPI transfer:
// no flicker and far fewer transactions than transparent text over a blit.
// Background is drawn at (-1,-1), hence the +1 source offset.
void drawSeamlessValue(int x, int y, float value, int type, uint16_t color) {
  const int w = 64, h = 16;
  uint16_t* buf = valueCanvas.getBuffer();
  for (int row = 0; row < h; row++) {
    for (int col = 0; col < w; col++) {
      buf[row * w + col] = pgm_read_word(&image_image_mesh_gradient_pixels[(y + row + 1) * 320 + (x + col + 1)]);
    }
  }
  valueCanvas.setFont();
  valueCanvas.setTextSize(2);
  valueCanvas.setTextWrap(false);
  valueCanvas.setTextColor(color);
  valueCanvas.setCursor(0, 0);
  if (type == 0) valueCanvas.printf("%4.0f", value);
  else if (type == 1) valueCanvas.printf("%4.2f", value);
  else if (type == 2) valueCanvas.printf("%4.1f", value);
  else if (type == 3) valueCanvas.printf("%3d", (int)value);
  gfx->drawRGBBitmap(x, y, buf, w, h);
}

// ================= fuel calibration helpers =================
void recordAnchor(uint16_t* anc, const char* key, uint8_t oldH, uint8_t newH, float ema) {
  int k = (oldH > newH) ? oldH : newH;   // boundary crossed = upper of the two
  if (k < 1 || k >= ANCHOR_SLOTS || ema < 0) return;
  uint16_t raw = (uint16_t)(ema + 0.5f);
  anc[k] = anc[k] ? (uint16_t)(((uint32_t)anc[k] + raw) / 2) : raw;  // merge repeats
  prefs.putBytes(key, anc, ANCHOR_SLOTS * sizeof(uint16_t));
  Serial.printf("[cal] anchor %s: %.1fL @ raw %u\n", key, k * 0.5f, anc[k]);
}

// Interpolate litres from a smoothed raw value, constrained to the 0.5L
// window the cluster currently reports - calibration refines, never contradicts.
float sideLitres(const uint16_t* anc, float ema, uint8_t h) {
  float base = h * 0.5f;
  if (ema < 0) return base + 0.25f;
  int k1 = -1, k2 = -1;
  for (int k = h; k >= 1; k--)               if (anc[k]) { k1 = k; break; }
  for (int k = h + 1; k < ANCHOR_SLOTS; k++) if (anc[k]) { k2 = k; break; }
  if (k1 < 0 || k2 < 0 || anc[k1] == anc[k2]) return base + 0.25f;
  float lit = 0.5f * (k1 + (float)(k2 - k1) * (ema - (float)anc[k1]) / ((float)anc[k2] - (float)anc[k1]));
  if (lit < base) lit = base;
  if (lit > base + 0.5f) lit = base + 0.5f;
  return lit;
}

float tankEstimate() {
  if (halvesL == 0xFF) return -1;
  float eL = -1, eR = -1;
  if (pairing == 1) { eL = emaA; eR = emaB; }
  else if (pairing == 2) { eL = emaB; eR = emaA; }
  return sideLitres(ancL, eL, halvesL) + sideLitres(ancR, eR, halvesR);
}

void handleHalves(uint8_t nL, uint8_t nR) {
  if (halvesL == 0xFF) {                       // first reading after power-on
    halvesL = nL; halvesR = nR;
    tickBaseA = emaA; tickBaseB = emaB;
    return;
  }
  bool chL = (nL != halvesL), chR = (nR != halvesR);
  if (!chL && !chR) { pendL = pendR = 0xFF; return; }
  if (pendL != nL || pendR != nR) {            // new transition: confirm on next frame (~10s)
    pendL = nL; pendR = nR;
    return;
  }
  // confirmed 0.5L tick. Multi-step jumps (refuelling) cross several boundaries
  // at once - we can't know the raw value at each, so only 1-step ticks calibrate.
  int stepL = abs((int)nL - (int)halvesL), stepR = abs((int)nR - (int)halvesR);
  if ((chL != chR) && tickBaseA >= 0 && (chL ? stepL : stepR) == 1) {  // single side, single step: vote on sensor pairing
    float dA = fabsf(emaA - tickBaseA), dB = fabsf(emaB - tickBaseB);
    int v = (dA > dB) ? 1 : -1;                // the field that moved more belongs to the side that ticked
    pairVote += chL ? v : -v;
    if (pairVote > 3) pairVote = 3;
    if (pairVote < -3) pairVote = -3;
    int8_t newPair = (pairVote >= 3) ? 1 : (pairVote <= -3) ? 2 : pairing;
    prefs.putChar("vote", pairVote);
    if (newPair != pairing) {
      pairing = newPair;
      prefs.putChar("pair", pairing);
      Serial.printf("[cal] pairing decided: 0x349 bytes0-1 = %s tank\n", pairing == 1 ? "LEFT" : "RIGHT");
    }
  }
  if (pairing) {
    float emaLeft = (pairing == 1) ? emaA : emaB;
    float emaRight = (pairing == 1) ? emaB : emaA;
    if (chL && stepL == 1) recordAnchor(ancL, "ancL", halvesL, nL, emaLeft);
    if (chR && stepR == 1) recordAnchor(ancR, "ancR", halvesR, nR, emaRight);
  }
  halvesL = nL; halvesR = nR;
  tickBaseA = emaA; tickBaseB = emaB;
  pendL = pendR = 0xFF;
}

void bootSequence() {
  drawScreen_2();
  rpm = 0; speed = 0; dist = 0; boost = 0; coolant = 0; oil = 0; tank_total = 0; l_per_100km = 0;
  prev_rpm = -1; prev_speed = -1; prev_coolant = -1; prev_oil = -1;
  prev_dist = -1; prev_boost = -99999; prev_tank = -1; prev_consum = -1;
  oilWarnTriggered = false; coolantWarnTriggered = false; rpmWarnTriggered = false;
  emaA = emaB = -1;
  halvesL = halvesR = 0xFF;
  pendL = pendR = 0xFF;
  consHave = false; consAccum = 0; lph = -1;
  drawScreen_1();
  revealStart = millis();
  last_t = millis();
  lastDisplayUpdate = 0;
  consWindowStart = millis();
  pendingAudioTrack = 1;
}

void handleCanFrame(const twai_message_t& msg) {
  if (msg.identifier == 0x130 && msg.data_length_code >= 1) {
    if (millis() - lastIgnitionChange > 2500) {
      if (msg.data[0] != 0x00 && !systemIsOn) {
        systemIsOn = true;
        bootSequence();
        lastIgnitionChange = millis();
      } else if (msg.data[0] == 0x00 && systemIsOn) {
        systemIsOn = false;
        pendingAudioTrack = -1;
        safePlay(5);
        shutdownAnimation();   // ~1.1s, replaces the old delay(1000) + blank
        lastIgnitionChange = millis();
      }
    }
  }

  if (!systemIsOn) return;

  switch (msg.identifier) {
    case 0x330:
      if (msg.data_length_code >= 6 && msg.data[4] <= 90 && msg.data[5] <= 90) {
        handleHalves(msg.data[4], msg.data[5]);
      }
      break;
    case 0x349:
      if (msg.data_length_code >= 4) {
        uint16_t a = msg.data[0] | (msg.data[1] << 8);
        uint16_t b = msg.data[2] | (msg.data[3] << 8);
        if (emaA < 0) { emaA = a; emaB = b; }
        else { emaA += (a - emaA) * 0.02f; emaB += (b - emaB) * 0.02f; }  // ~10s smoothing vs slosh
      }
      break;
    case 0x2F3:
      if (msg.data_length_code >= 6) {
        uint16_t p = msg.data[4] | (msg.data[5] << 8);
        if (rpmSeen && rpm == 0) {
          baroRef = p;               // engine not spinning: manifold = ambient
          // Persist so a start-engine-before-boot drive still has a reference.
          // Throttled to spare flash: only on >=5 mbar change, max every 60 s.
          if (abs((int)p - (int)baroSaved) >= 10 && millis() - lastBaroSave > 60000) {
            prefs.putUShort("baro", p);
            baroSaved = p;
            lastBaroSave = millis();
          }
        } else if (baroRef) {
          boost = ((int)p - (int)baroRef) * BOOST_BAR_PER_COUNT;
        }
      }
      break;
    case 0x2C4:
      if (msg.data_length_code >= 2) {
        uint16_t c = msg.data[0] | (msg.data[1] << 8);
        if (consHave) consAccum += (uint16_t)(c - consPrev);
        consPrev = c;
        consHave = true;
      }
      break;
    case 0xA5:
      if (msg.data_length_code >= 8) {
        // rpm is bytes 5-6 little-endian; byte 7 is a constant status (0xF1).
        // The old (B6<<8)+B7 decode was within +-32 rpm by luck and read 60 with engine off.
        float raw_rpm = ((msg.data[6] << 8) | msg.data[5]) / 4.0;
        rpm = (raw_rpm < 100) ? 0 : raw_rpm;
        rpmSeen = true;
        if (rpm > 4000 && !rpmWarnTriggered) { pendingAudioTrack = 4; rpmWarnTriggered = true; }
        else if (rpm <= 3800) { rpmWarnTriggered = false; }
      }
      break;
    case 0x1A1:
      if (msg.data_length_code >= 4) {
        speed = ((msg.data[3] << 8) + msg.data[2]) / 64.0;
        dist += (speed / 3600.0) * ((millis() - last_t) / 1000.0);
        last_t = millis();
      }
      break;
    case 0x3F9:
      if (msg.data_length_code >= 6) {
        coolant = msg.data[4] - 48;
        oil = msg.data[5] - 48;
        if (oil > 95 && !oilWarnTriggered) { pendingAudioTrack = 2; oilWarnTriggered = true; }
        else if (oil <= 90) { oilWarnTriggered = false; }
        if (coolant > 95 && !coolantWarnTriggered) { pendingAudioTrack = 3; coolantWarnTriggered = true; }
        else if (coolant <= 90) { coolantWarnTriggered = false; }
      }
      break;
  }
}

void setup() {
  Serial.begin(115200);
  tft.begin();
  tft.setRotation(1);
  tft.fillScreen(0x0000);

  prefs.begin("fuelcal", false);
  prefs.getBytes("ancL", ancL, sizeof(ancL));   // absent keys leave arrays zeroed
  prefs.getBytes("ancR", ancR, sizeof(ancR));
  pairVote = prefs.getChar("vote", 0);
  pairing = prefs.getChar("pair", 0);
  baroRef = baroSaved = prefs.getUShort("baro", 0);  // last known ambient (0 = never captured)
  int nA = 0;
  for (int k = 0; k < ANCHOR_SLOTS; k++) nA += (ancL[k] != 0) + (ancR[k] != 0);
  Serial.printf("[cal] loaded %d anchors, pairing=%d vote=%d\n", nA, pairing, pairVote);

  twai_general_config_t g_config = TWAI_GENERAL_CONFIG_DEFAULT((gpio_num_t)5, (gpio_num_t)3, TWAI_MODE_LISTEN_ONLY);
  g_config.rx_queue_len = 32;                   // survive display/audio bursts without drops
  twai_timing_config_t t_config = TWAI_TIMING_CONFIG_500KBITS();
  twai_filter_config_t f_config = TWAI_FILTER_CONFIG_ACCEPT_ALL();
  if (twai_driver_install(&g_config, &t_config, &f_config) != ESP_OK) Serial.println("TWAI install failed");
  twai_start();

  DFSerial.begin(9600, SERIAL_8N1, 20, 21);
  delay(1000);

  if (myDFPlayer.begin(DFSerial, false, false)) {
    myDFPlayer.volume(30);                      // DFPlayer range is 0-30
    myDFPlayer.enableDAC();
  }
}

void loop() {
  if (pendingAudioTrack > 0 && (millis() - lastAudioTime > 2000)) {
    safePlay(pendingAudioTrack);
    pendingAudioTrack = -1;
    lastAudioTime = millis();
  }

  // Drain the RX queue each pass; block max 5ms when idle so the core can rest.
  twai_message_t msg;
  int budget = 40;
  uint32_t wait = pdMS_TO_TICKS(5);
  while (budget-- > 0 && twai_receive(&msg, wait) == ESP_OK) {
    wait = 0;
    handleCanFrame(msg);
  }

  if (!systemIsOn) return;

  // consumption rate window (1s, light smoothing; snap to 0 on overrun fuel cut
  // so the readout matches the OBC's instant behaviour)
  if (millis() - consWindowStart > 1000) {
    float secs = (millis() - consWindowStart) / 1000.0f;
    float inst = (consAccum / secs) * LITRES_PER_COUNT * 3600.0f;   // L/h
    if (inst < 0.05f) lph = 0;
    else lph = (lph < 0) ? inst : lph * 0.5f + inst * 0.5f;
    consAccum = 0;
    consWindowStart = millis();
    l_per_100km = (speed > 5) ? (lph / speed) * 100.0f : lph;
    if (l_per_100km > 99.9f) l_per_100km = 99.9f;
  }

  if (millis() - lastDisplayUpdate > 150) {
    // reveal order: RPM, SPEED, DIST, CONSUM, OIL, COOL, BOOST, TANK
    int q;
    q = (int)roundf(rpm);
    if (slotOpen(0) && q != prev_rpm) { drawSeamlessValue(253, 93, rpm, 0, getRpmColor(rpm)); prev_rpm = q; }
    q = (int)roundf(speed);
    if (slotOpen(1) && q != prev_speed) { drawSeamlessValue(253, 129, speed, 0, 0xFFFF); prev_speed = q; }
    float distShown = (dist > 999.9f) ? 999.9f : dist;   // 6 chars would overflow the patch
    if (slotOpen(2) && (long)roundf(distShown * 10) != prev_dist) { drawSeamlessValue(253, 163, distShown, 2, 0xFFFF); prev_dist = (long)roundf(distShown * 10); }
    if (slotOpen(3) && (long)roundf(l_per_100km * 10) != prev_consum) { drawSeamlessValue(253, 197, l_per_100km, 2, 0xFFFF); prev_consum = (long)roundf(l_per_100km * 10); }
    if (slotOpen(4) && oil != prev_oil) { drawSeamlessValue(88, 96, oil, 3, 0xFFFF); prev_oil = oil; }
    if (slotOpen(5) && coolant != prev_coolant) { drawSeamlessValue(88, 130, coolant, 3, 0xFFFF); prev_coolant = coolant; }
    if (slotOpen(6) && (long)roundf(boost * 100) != prev_boost) { drawSeamlessValue(88, 164, boost, 1, 0xFFFF); prev_boost = (long)roundf(boost * 100); }
    float t = tankEstimate();
    if (t >= 0) {
      tank_total = t;
      if (slotOpen(7) && (long)roundf(t * 10) != prev_tank) { drawSeamlessValue(88, 198, t, 2, 0xFFFF); prev_tank = (long)roundf(t * 10); }
    }
    lastDisplayUpdate = millis();
  }

  if (millis() - lastStatusPrint > 10000) {
    Serial.printf("[st] rawA=%.0f rawB=%.0f halves L=%u R=%u pair=%d vote=%d tank=%.2fL lph=%.2f cons=%.1f rpm=%.0f spd=%.0f\n",
                  emaA, emaB, halvesL, halvesR, pairing, pairVote, tankEstimate(), lph, l_per_100km, rpm, speed);
    lastStatusPrint = millis();
  }
}
